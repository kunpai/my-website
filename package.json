{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "validate": "node scripts/validate-content.js",
    "generate": "node scripts/generate_llms_txt.js && node scripts/generate_rss.js",
    "predev": "node scripts/setup.js --ensure && npm run generate",
    "dev": "LAST_UPDATED=$(date) next dev",
    "prebuild": "node scripts/setup.js --ensure && npm run validate && npm run generate",
    "build": "LAST_UPDATED=$(date) next build",
    "postbuild": "next-sitemap",
    "start": "LAST_UPDATED=$(date) next start",
    "lint": "eslint .",
    "indexnow": "node scripts/indexnow.js",
    "update": "node scripts/update-from-template.js"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "bootstrap": "^5.3.0",
    "gsap": "^3.12.2",
    "next": "^16.3.5",
    "next-sitemap": "^4.2.3",
    "parse-md": "^3.0.3",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-markdown": "^8.0.7",
    "rehype-highlight": "^6.0.0",
    "rehype-raw": "^6.1.1",
    "rehype-slug": "^5.1.0",
    "remark-frontmatter": "^4.0.1",
    "remark-gfm": "^3.0.1",
    "remark-slug": "^7.0.1",
    "remark-toc": "^8.0.1",
    "split-type": "^0.3.3",
    "styled-components": "^6.1.12"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5"
  }
}
